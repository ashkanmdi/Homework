def determinant(matrix):

    if len(matrix) == 1:
        return matrix[0][0]

    det = 0

    for j in range(len(matrix)):
        new_matrix = []

        for i in range(1, len(matrix)):
            row = matrix[i][:j] + matrix[i][j+1:]
            new_matrix.append(row)

        det = det + ((-1) ** j) * matrix[0][j] * determinant(new_matrix)

    return det


matrix = []

for i in range(5):
    row = []
    for j in range(5):
        x = float(input("Enter number: "))
        row.append(x)

    matrix.append(row)

print("Determinant =", determinant(matrix))