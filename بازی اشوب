import turtle as t
from random import choice

t.speed(0)
t.tracer(0)
t.hideturtle()
t.penup()
vertices = [
    ((-250, -200), "blue"),
    ((250, -200), "green"),
    ((0, 230), "yellow"),
]

x, y = 0, 0

for i in range(20000):
    (vx, vy), color = choice(vertices)
    x = (x + vx) / 2
    y = (y + vy) / 2
    t.goto(x, y)
    t.dot(2, color)
    if i % 10000 == 0:
        t.update()

t.update()
t.done()